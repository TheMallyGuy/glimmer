{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glimmer",
  "version": "0.1.0",
  "identifier": "com.mally.glimmer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "glimmer",
        "width": 562,
        "height": 322,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin" : [
      "./external/BuildersColors"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "./resources/mods/**/*.png",
      "./resources/mods/**/*.mp3",
      "./resources/mods/**/*.rbxl"
    ]
  }
}