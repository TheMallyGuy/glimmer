{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glimmer",
  "version": "0.1.2",
  "identifier": "com.mally.glimmer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "glimmer overlay",
        "url": "/overlay",
        "width": 420,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "title": "glimmer",
        "width": 562,
        "height": 322,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "./resources/mods/**/*.png",
      "./resources/mods/**/*.mp3",
      "./resources/mods/**/*.rbxl"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NTRBRkEyMDkxQUZGQzQKUldURS94b0pvcTlVeUhYUFRTOTRpcG8yYlQ2QWdXNm1iQ0ZJSk9uOGNTL0YySmhLTmVicjA4L0cK",
      "endpoints": [
        "https://cdn.crabnebula.app/update/glim/glimmer/{{target}}-{{arch}}/{{current_version}}"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "roblox-player",
          "roblox"
        ]
      }
    }
  }
}