      }
    },
    "doneTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "Finished",
        "vi": "Hoàn thành"
      }
    },
    "doneBlurb": {
      "nodeType": "translation",
      "translation": {
        "en": "Glimmer is ready. Pick Player or Studio in the next window.",
        "vi": "Glimmer đã sẵn sàng. Chọn Player hoặc Studio trong cửa sổ tiếp theo."
      }
    },
    "finish": {
      "nodeType": "translation",
      "translation": {
        "en": "Open Glimmer",
        "vi": "Mở Glimmer"
      }
    }
