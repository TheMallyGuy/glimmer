{
  "$schema": "https://intlayer.org/schema.json",
  "key": "tour",
  "content": {
    "welcomeTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "Welcome to Glimmer",
        "vi": "Chào mừng đến với Glimmer"
      }
    },
    "welcomeBlurb": {
      "nodeType": "translation",
      "translation": {
        "en": "A Roblox bootstrapper. Two quick steps and you are in.",
        "vi": "Đây là hướng dẫn để nhanh chóng cấu hình Glimmer và bắt đầu!"
      }
    },
    "getStarted": {
      "nodeType": "translation",
      "translation": {
        "en": "Get started",
        "vi": "Bắt đầu"
      }
    },
    "skip": {
      "nodeType": "translation",
      "translation": {
        "en": "Skip",
        "vi": "Bỏ qua"
      }
    },
    "back": {
      "nodeType": "translation",
      "translation": {
        "en": "Back",
        "vi": "Quay lại"
      }
    },
    "next": {
      "nodeType": "translation",
      "translation": {
        "en": "Next",
        "vi": "Tiếp theo"
      }
    },
    "languageTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "Language",
        "vi": "Ngôn ngữ"
      }
    },
    "languageBlurb": {
      "nodeType": "translation",
      "translation": {
        "en": "Pick the language Glimmer is shown in. You can change it later in Appearance.",
