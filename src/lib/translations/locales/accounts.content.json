{
  "$schema": "https://intlayer.org/schema.json",
  "key": "accounts",
  "content": {
    "intro": {
      "nodeType": "translation",
      "translation": {
        "en": "Pick the Roblox account to sign in with. It's used the next time you launch.",
        "vi": "Chọn tài khoản Roblox để đăng nhập. Nó sẽ được sử dụng lần sau khi bạn khởi chạy."
      }
    },
    "addAccount": {
      "nodeType": "translation",
      "translation": {
        "en": "Add account",
        "vi": "Thêm tài khoản"
      }
    },
    "waitingForLogin": {
      "nodeType": "translation",
      "translation": {
        "en": "Waiting for you to log in…",
        "vi": "Đang chờ bạn đăng nhập…"
      }
    },
    "cancelLogin": {
      "nodeType": "translation",
      "translation": {
        "en": "Cancel",
        "vi": "Hủy"
      }
    },
    "loginFailed": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Couldn't add the account. {{error}}"
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "Không thể thêm tài khoản. {{error}}"
        }
      }
    },
    "emptyTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "No accounts yet",
        "vi": "Chưa có tài khoản nào"
      }
    },
    "emptyBody": {
      "nodeType": "translation",
      "translation": {
        "en": "Conveniently add accounts and switch to it with one click!, Uses keyrings to secure your credentials.",
        "vi": "Thêm tài khoản một cách thuận tiện và chuyển đổi với một cú nhấn!, Sử dụng keyring để bảo mật thông tin đăng nhập của bạn."
      }
    },
    "forcedTitle": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Logging in as {{name}}"
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "Đang đăng nhập với {{name}}"
        }
      }
    },
    "forcedDescription": {
      "nodeType": "translation",
      "translation": {
        "en": "This account will be the next account that Roblox will signed in as! You can click stop to stop forcing.",
        "vi": "Tài khoản này sẽ là tài khoản mà Roblox sẽ đăng nhập vào lần sau! Bạn có thể nhấn dừng để dừng ép buộc."
      }
    },
    "useRobloxLogin": {
      "nodeType": "translation",
      "translation": {
        "en": "Stop forcing an account",
        "vi": "Dừng ép buộc một tài khoản"
      }
    },
    "unforcedTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "Select an account!",
        "vi": "Chọn một tài khoản!"
      }
    },
    "unforcedDescription": {
      "nodeType": "translation",
      "translation": {
        "en": "In the next launch, We'll forcfully sign in as the account you pick.",
        "vi": "Trong lần khởi chạy tiếp theo, chúng tôi sẽ ép buộc đăng nhập bằng tài khoản bạn chọn."
      }
    },
    "useAccount": {
      "nodeType": "translation",
      "translation": {
        "en": "Use this account",
        "vi": "Sử dụng tài khoản này"
      }
