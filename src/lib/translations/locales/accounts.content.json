    "selected": {
      "nodeType": "translation",
      "translation": {
        "en": "Logged in next launch",
        "vi": "Đăng nhập lần sau"
      }
    },
    "expired": {
      "nodeType": "translation",
      "translation": {
        "en": "Login expired. Remove this account and add it again.",
        "vi": "Đăng nhập đã hết hạn. Xóa tài khoản này và thêm lại."
      }
    },
    "usernameLine": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "@{{name}}"
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "@{{name}}"
        }
      }
    },
    "removeAccount": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Remove {{name}}"
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "Xóa {{name}}"
        }
      }
    },
    "removeTitle": {
      "nodeType": "translation",
      "translation": {
        "en": "Remove account",
        "vi": "Xóa tài khoản"
      }
    },
    "removeBody": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Remove {{name}} from Glimmer? Their saved login is deleted. You can add the account again later."
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "Xóa {{name}} khỏi Glimmer? Đăng nhập đã lưu của họ sẽ bị xóa. Bạn có thể thêm lại tài khoản này sau này."
        }
      }
    },
    "remove": {
      "nodeType": "translation",
      "translation": {
        "en": "Remove account",
        "vi": "Xóa tài khoản"
      }
    },
    "avatarAlt": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Avatar of {{name}}"
        },
        "vi": {
          "nodeType": "insertion",
          "insertion": "Ảnh đại diện của {{name}}"
        }
      }
    }
  },
  "location": "local",
  "title": "Accounts",
  "description": "Multilingual content declarations for account management and sign-in flows.",
  "tags": ["accounts", "authentication", "localization"]
