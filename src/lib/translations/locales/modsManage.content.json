{
  "$schema": "https://intlayer.org/schema.json",
  "key": "modsManage",
  "content": {
    "modCount": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "enumeration",
          "enumeration": {
            "1": {
              "nodeType": "insertion",
              "insertion": "{{count}} mod"
            },
            "fallback": {
              "nodeType": "insertion",
              "insertion": "{{count}} mods"
            }
          }
        }
      }
    },
    "enabledSuffix": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "{{enabledCount}} on"
        }
      }
    },
    "openFolder": {
      "nodeType": "translation",
      "translation": {
        "en": "Open folder"
      }
    },
    "newMod": {
      "nodeType": "translation",
      "translation": {
        "en": "New mod"
      }
    },
    "emptyNoMods": {
      "nodeType": "translation",
      "translation": {
        "en": "No mods yet. Create one, or install one from Community!"
      }
    },
    "createAMod": {
      "nodeType": "translation",
      "translation": {
        "en": "Create a mod"
      }
    },
    "browseCommunityMods": {
      "nodeType": "translation",
      "translation": {
        "en": "Browse community mods"
      }
    },
    "deleted": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Deleted {{name}}"
        }
      }
    },
    "undo": {
      "nodeType": "translation",
      "translation": {
        "en": "Undo"
      }
    },
    "tip": {
      "nodeType": "translation",
      "translation": {
        "en": "Tip: Top of the list wins when two mods change the same file. Click a name to rename it, or right-click a mod for more!"
      }
    },
    "needsAName": {
      "nodeType": "translation",
      "translation": {
        "en": "Needs a name"
      }
    },
    "nameAlreadyUsed": {
      "nodeType": "translation",
      "translation": {
        "en": "Name already used"
      }
    },
    "announceCreated": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Created {{name}}."
        }
      }
    },
    "announceRenamed": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Renamed to {{name}}."
        }
      }
    },
    "announceDeleted": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Deleted {{name}}. Press Undo to bring it back."
        }
      }
    },
    "announceRestored": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Restored {{name}}."
        }
      }
    },
    "announceMoved": {
      "nodeType": "translation",
      "translation": {
        "en": {
          "nodeType": "insertion",
          "insertion": "Moved {{name}} to position {{position}} of {{total}}."
        }
      }
    }
  }
}
